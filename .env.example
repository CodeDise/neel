# ---- Telegram ----
BOT_TOKEN=123456:ABC...
BOT_USERNAME=Aodoxbot
API_ID=1234567                       # my.telegram.org  (needed for big-video streaming)
API_HASH=abcdef0123456789abcdef
MINIAPP_SHORT=app                    # Mini App short name from BotFather (/newapp). Needed for t.me/bot/app?startapp= links
WEBAPP_URL=https://your-app.onrender.com
STORAGE_CHANNEL_ID=-1001234567890    # PRIVATE channel, bot must be admin
UPDATE_CHANNEL=@aodohd
UPDATE_CHANNEL_URL=                  # only for private update channel (invite link)
SUPER_ADMIN_IDS=11111111             # owners, comma separated

# ---- MongoDB shards: separate clusters, separated by ;  (first one also holds meta/users/payments)
MONGO_URIS=mongodb+srv://user:pass@cluster0.xxx.mongodb.net;mongodb+srv://user:pass@cluster1.xxx.mongodb.net
DB_NAME=neel
SHARD_MAX_MB=450                     # auto-switch to next shard at this size (Atlas free = 512MB)

# ---- Oxapay ----
OXAPAY_KEY=your_merchant_api_key

# ---- Misc ----
APP_NAME=Aodox
SECRET=change-me-to-a-long-random-string
